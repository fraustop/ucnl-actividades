rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Documentos escolares:
    // Lectura pública: cualquier usuario con el enlace puede descargar y ver documentos
    // Escritura / Borrado: solo usuarios autenticados pueden subir o eliminar archivos
    match /activities/{allPaths=**} {
      allow read: if true;
      allow write, delete: if request.auth != null;
    }
    
    // Por defecto para cualquier otra ruta
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
