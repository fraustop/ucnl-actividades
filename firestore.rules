rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Actividades escolares: requiere autenticación obligatoria
    match /activities/{activityId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // Documento de sincronización y metadata de versiones
    match /metadata/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Configuración de Tetramestres y Materias
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Repositorio general de recursos y enlaces a archivos
    match /resources/{resourceId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Perfiles de usuario y subcolecciones (completados y tokens FCM)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      // Progreso personal del estudiante
      match /completions/{activityId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Tokens de notificaciones push
      match /tokens/{tokenId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Notificaciones internas de administración
    match /admin_notifications/{notifId} {
      allow read, write: if request.auth != null;
    }

    // Canal de difusiones y alertas en tiempo real para todos los dispositivos
    match /broadcast_notifications/{notifId} {
      allow read, write: if true;
    }
  }
}
